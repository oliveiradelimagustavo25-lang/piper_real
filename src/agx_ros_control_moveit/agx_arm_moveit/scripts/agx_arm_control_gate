#!/usr/bin/env python3
# -*-coding:utf8-*-
import time

import rclpy
from rclpy.node import Node
from action_msgs.msg import GoalStatusArray
from std_srvs.srv import SetBool


class ControlGate(Node):
    def __init__(self):
        super().__init__("control_gate")
        self.declare_parameter(
            "status_topics",
            ["arm_controller/follow_joint_trajectory/_action/status"],
        )
        self.declare_parameter("gate_service_name", "control_enable")

        self.status_topics = list(self.get_parameter("status_topics").value)
        self.gate_service_name = self.get_parameter("gate_service_name").value

        self._active_states = {1, 2, 3}  # ACCEPTED, EXECUTING, CANCELING
        self._gate_open = None
        self._pending = None
        self._service_ready_logged = False
        self._topic_is_active = {}

        self._gate_client = self.create_client(SetBool, self.gate_service_name)
        for topic in self.status_topics:
            self._topic_is_active[topic] = False
            self.create_subscription(
                GoalStatusArray,
                topic,
                lambda msg, t=topic: self._status_callback(msg, t),
                10,
            )

        self._sync_timer = self.create_timer(0.2, self._sync_gate)
        self.get_logger().info(
            f"Control gate started. status_topics={self.status_topics}, "
            f"gate_service_name={self.gate_service_name}"
        )

    def _sync_gate(self):
        if not self._gate_client.service_is_ready():
            self._gate_open = None
            self._service_ready_logged = False
            if self._pending is not None:
                self._gate_client.remove_pending_request(self._pending[0])
                self._pending[0].cancel()
                self._pending = None
            return
        if not self._service_ready_logged:
            self.get_logger().info("Gate service is ready, synchronizing execution state")
            self._service_ready_logged = True
        if self._pending is not None:
            future, requested, sent_at = self._pending
            if not future.done() and time.monotonic() - sent_at < 2.0:
                return
            self._pending = None
            try:
                if not future.done():
                    self._gate_client.remove_pending_request(future)
                    future.cancel()
                    raise TimeoutError("Gate service response timed out")
                response = future.result()
                if not response.success:
                    raise RuntimeError(response.message or "Gate service rejected the request")
                self._gate_open = requested
                state = "opened" if requested else "closed"
                self.get_logger().info(f"External control gate confirmed {state}")
            except Exception as error:
                self._gate_open = None  # A failed acknowledgement leaves the actual state unknown.
                self.get_logger().warning(str(error), throttle_duration_sec=5.0)

        desired = any(self._topic_is_active.values())
        if self._gate_open != desired:
            request = SetBool.Request()
            request.data = desired
            self._pending = (self._gate_client.call_async(request), desired, time.monotonic())

    def _status_callback(self, msg: GoalStatusArray, topic_name: str):
        self._topic_is_active[topic_name] = any(
            status.status in self._active_states for status in msg.status_list
        )
        self._sync_gate()


def main(args=None):
    rclpy.init(args=args)
    node = ControlGate()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
