<?xml version="1.0"?>
<package format="3">
  <name>my_robot_planner</name>
  <version>0.1.0</version>
  <description>Color and distance based pick-and-place task planning.</description>
  <maintainer email="oliveiradelimagustavo25@gmail.com">ltt</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>my_robot_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
